# Vorlage für Umgebungsvariablen. NIE echte Werte committen.
# In Vercel: Project → Settings → Environment Variables.
# Keine Variable hier darf mit VITE_ beginnen, sonst landet sie im Browser.

# Resend (https://resend.com) – API-Key mit Sendeberechtigung
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Empfänger der Projektanfragen (BEO-Adresse)
ANFRAGE_TO=info@beostahlbau.ch
# Absender; die Domain muss in Resend verifiziert sein
ANFRAGE_FROM="BEO Stahl & Glasbau <anfrage@beostahlbau.ch>"
# Optional: Telefonnummer in der Bestätigungsmail
ANFRAGE_TELEFON=

# Vercel Blob (privater Speicher für Foto- und Plan-Uploads)
# Wird automatisch gesetzt, wenn ein Blob-Store mit dem Projekt verbunden ist.
BLOB_READ_WRITE_TOKEN=

# Optional: Upstash Redis für ein Rate-Limit über alle Server-Instanzen.
# Wird automatisch gesetzt, wenn Upstash über den Vercel Marketplace verbunden ist.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: zufälliger Wert, mit dem IP-Adressen vor dem Rate-Limit gehasht werden
RATE_LIMIT_SALT=

# Schutz für den täglichen Bereinigungs-Job (/api/cleanup). Zufälliger langer Wert.
CRON_SECRET=
